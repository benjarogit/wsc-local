# wsc-local – lokale Entwicklung (nicht für Produktion)
# Wird von ./setup.sh erzeugt. Passwort nie committen.

# Ein Login für WoltLab, MySQL, phpMyAdmin
ADMIN_USER=admin
ADMIN_PASSWORD=

# WoltLab Suite Core Version (öffentliches ZIP)
WSC_VERSION=6.2.5
WSC_SHA256=a6727fa7e95f84737cda6fbcfcf72ba691fdb4be965281197d1cae7011c6ee19

# Container-/Projekt-Prefix (Konfliktvermeidung)
NAME_PREFIX=woltlab
COMPOSE_PROJECT_NAME=wsc-local

# MySQL (= ADMIN_* nach Setup)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=woltlab
MYSQL_USER=
MYSQL_PASSWORD=

# Host-Ports
HTTP_PORT=8080
HTTPS_PORT=443
MYSQL_PORT=3307
PHPMYADMIN_PORT=8081
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025
PANEL_PORT=9099

# Sprache: de | en
LANG_UI=de

# Optional: eigener Datenbankpfad nur fuer den alten Einzel-Stack.
# LEGACY_DB_PATH=/absolute/path/to/legacy-database
